# GridForecast Environment Variables

# Optional: Google Gemini API Key for AI Day-Ahead Trading Copilot
# If omitted, system seamlessly falls back to the deterministic local rules engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# UK Day-Ahead Market Default Gate Closure (11:00 GMT on D-1 for EPEX SPOT)
DEFAULT_GATE_CLOSURE_HOUR=11

# Debug Mode
DEBUG=False
